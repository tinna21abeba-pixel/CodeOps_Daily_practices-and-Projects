  "components": {
    "schemas": {
      "ConcurrencyCheckResponse": {
        "type": "object",
        "properties": {
          "middlewareInstanceId": {
            "type": "string",
            "format": "uuid"
          },
          "controllerInstanceId": {
            "type": "string",
            "format": "uuid"
          },
          "requestedTag": {
            "type": "string",
            "nullable": true
          },
          "tagOnEntry": {
            "type": "string",
            "nullable": true
          },
          "tagAfterDelay": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "CreateOrderRequest": {
        "required": [
          "customerName",
          "customerPhone",
          "items",
          "restaurantId"
        ],
        "type": "object",
        "properties": {
          "restaurantId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "description": "Identifier of the restaurant receiving the order.",
            "format": "int32",
            "example": 1
          },
          "customerName": {
            "maxLength": 100,
            "minLength": 2,
            "type": "string",
            "description": "Full name of the customer placing the order.",
            "example": "Abebe Kebede"
          },
          "customerPhone": {
            "minLength": 1,
            "type": "string",
            "description": "Customer mobile phone number in Ethiopian format (09..., 07..., +2519..., or +2517...).",
            "example": "+251911234567"
          },
          "isDelivery": {
            "type": "boolean",
            "description": "Whether the order requires courier delivery (true) or pickup (false).",
            "example": true
          },
          "deliveryAddress": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string",
            "description": "Street delivery address; required when IsDelivery is true.",
            "nullable": true,
            "example": "Cameroon St, Bole, Addis Ababa"
          },
          "specialInstructions": {
            "maxLength": 500,
            "minLength": 0,
            "type": "string",
            "description": "Optional preparation or delivery instructions.",
            "nullable": true,
            "example": "Please call upon arrival at the main gate"
          },
          "tipEtb": {
            "type": "number",
            "description": "Optional courier tip in ETB (positive, at most two decimal places).",
            "format": "double",
            "nullable": true,
            "example": 50
          },
          "items": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrderItemRequest"
