{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "AddisEats.Api": "Debug",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*",

  "Delivery": {
    "FreeAboveEtb": 1000,
    "DefaultFeeEtb": 100
  },

  "Jwt": {
    "Key": "AddisEats-Dev-Signing-Key-32+Bytes-Long-2026!",
    "Issuer": "AddisEats.Api",
    "Audience": "AddisEats.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  }
}

